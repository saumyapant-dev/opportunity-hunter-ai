# Server Configuration
# In production on cloud hosts (Render/Railway), use HOST=0.0.0.0 and dynamic PORT
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
CORS_ORIGINS=*

# Database
DATABASE_PATH=backend/data/opportunities.db

# LLM & AI Provider (OpenRouter, OpenAI, or Mock)
# Options: "openrouter" | "openai" | "mock"
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=meta-llama/llama-3.3-70b-instruct
LLM_BASE_URL=https://openrouter.ai/api/v1

# Browser Use & Playwright Settings
BROWSER_USE_HEADLESS=true
BROWSER_USE_CONFIG_DIR=./.browseruse
BROWSER_USE_MAX_STEPS=25

# n8n Workflow Integration
# Base webhook URL for triggering manual discovery workflow
N8N_WEBHOOK_URL=http://localhost:5678/webhook/opportunity-research
N8N_API_KEY=
N8N_INTEGRATION_ENABLED=false

# Notification Preferences
DEFAULT_NOTIFICATION_EMAIL=student@example.com
